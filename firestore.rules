rules_version = '2';

// Regras sugeridas para o projeto Replay.
// Copie e ajuste no console do Firebase (Firestore > Regras).
//
// Contexto: não há login de usuário — todo mundo usa auth anônima (garantirAuth()
// no firebase.js). Por isso não dá pra restringir leitura/escrita por "dono" real.
// O painel admin (/admin) também lê a coleção inteira pra montar as métricas,
// então a leitura precisa ficar liberada para qualquer usuário autenticado
// (mesmo anonimamente). A senha do /admin é só uma barreira de UI, não uma
// regra de segurança de dados — os dados em si não são sensíveis (sem nome,
// e-mail ou identificação pessoal, só um ID aleatório).

service cloud.firestore {
  match /databases/{database}/documents {
    match /caderninhos/{caderninhoId} {
      // Qualquer usuário autenticado (inclusive anônimo) pode ler —
      // necessário para o painel admin agregar estatísticas.
      allow read: if request.auth != null;

      // Criação: permite criar um novo caderninho vazio.
      allow create: if request.auth != null;

      // Atualização: permite salvar respostas e o lote sorteado.
      // (não há como amarrar isso ao "dono" sem login real, então
      // qualquer autenticado pode atualizar qualquer documento —
      // aceitável aqui porque o ID já funciona como uma chave obscura
      // e não há dado sensível em jogo)
      allow update: if request.auth != null;

      allow delete: if false;
    }
  }
}
